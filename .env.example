# Salin ke .env lalu isi nilainya. JANGAN commit file .env.

# ── Database (container "db" di docker-compose) ─────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=finance_tracker

# Opsional: database cloud (mis. Supabase). Bila diisi, container db diabaikan.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Opsional (menjalankan backend tanpa docker): DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME, DB_SSLMODE

# ── Backend ─────────────────────────────────────────────────────────
# Wajib di production: dipakai untuk CORS, redirect login Google, dan link di email
FRONTEND_URL=http://localhost:5173
# Minimal 32 karakter acak, contoh: openssl rand -hex 32
JWT_SECRET=
# IP/CIDR reverse proxy yang boleh mengisi X-Forwarded-For (dipisah koma), atau "none"
# TRUSTED_PROXIES=
# Opsional: PORT, PYTHON_BIN, ML_SCRIPT, PREDICT_TIMEOUT_SECONDS (60), PREDICT_MAX_CONCURRENCY (2)

# ── Login Google (Google Cloud Console → OAuth 2.0 Client) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ── Email (verifikasi & reset password) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ── Frontend (di-bake saat build) ───────────────────────────────────
VITE_API_URL=http://localhost:8080
